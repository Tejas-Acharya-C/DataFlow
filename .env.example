# DataFlow Environment Configuration

# Application Environment (development, testing, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Server Configuration
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database URL
# PostgreSQL standard connection string (psycopg 3 driver):
# postgresql+psycopg://postgres:postgres@localhost:5432/dataflow
# For Docker Compose setup on port 55432:
# postgresql+psycopg://dataflow:dataflow@localhost:55432/dataflow
# Fallback to local SQLite if PostgreSQL is not available in development/testing:
DATAFLOW_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dataflow

# Storage Root Directory (relative or absolute)
DATAFLOW_STORAGE_ROOT=./dataflow_storage

# Ingestion & Preview Constraints
MAX_UPLOAD_SIZE_BYTES=52428800
MAX_PREVIEW_ROWS=100
MAX_VALIDATION_EXAMPLES=20
